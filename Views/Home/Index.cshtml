@{
    ViewData["Title"] = "Home";
}
<head>
    <link href="~/css/style.css" rel="stylesheet" />
</head>

<div class="main-header-bg">
    <center>
        <div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel" style="width:16cm;height:16cm; padding-top:2cm;">
            <div class="carousel-inner" style="width:16cm;height:12.5cm;">
                <div class="carousel-item active">
                    <img src="~/poster/th (1).jpeg" class="d-block w-100" />
                </div>
                <div class="carousel-item">
                    <img src="~/whatsapp image 2023-08-04 at 12.18.27.jpg" class="d-block w-100"/>
                                    </div>
                <div class="carousel-item">
                    <img src="~/pjt.jpg" class="d-block w-100" />
                    
                </div>
                <div class="carousel-item">
                    <img src="~/poster/th (2).jpeg" class="d-block w-100" />
                    
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </center>
</div>
