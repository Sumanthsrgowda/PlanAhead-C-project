@model WebApplication1.Models.deptmodel

@{
    ViewData["Title"] = "deleteDepartment";
    Layout = "_base.cshtml";
}

<h4>Delete Department</h4>

<div class="bgcolor">
    <form asp-action="deleteDepartment">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="DepartmentName" class="control-label"><b>Enter The Department Name</b></label>
            <input asp-for="DepartmentName" class="form-control" />
            <span asp-validation-for="DepartmentName" class="text-danger"></span>
        </div>
        <h3>Are you sure you want to delete this?</h3>
        <input type="submit" value="Delete" class="btn btn-danger button-align" onclick="return confirm('Are you sure,Want to Delete the Department?')" /> |
        <div><a asp-action="department">Back to List</a></div>
        
    </form>
</div>
